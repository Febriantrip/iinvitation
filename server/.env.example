# Copy file ini menjadi server/.env
# Default cocok untuk MySQL/XAMPP lokal dengan user root tanpa password.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=wedding_invitation

PORT=8787
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-local-password
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173
UPLOAD_DIR=./data/uploads

ALLOW_PRIVATE_LAN_ORIGINS=true
